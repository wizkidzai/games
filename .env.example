# Copy to .env.local and fill in values
# Never commit .env.local

VITE_MODEL_CDN=https://cdn.example.com/models/
VITE_APP_ENV=development
VITE_ENABLE_DEBUG=false
VITE_NFC_READER=true
VITE_ENROLL_URL=https://wizkidz.ai/enroll
VITE_SCORE_URL=https://games.wizkidz.ai/score

# Firebase Realtime Database — booth game leaderboards
# Get these from the Firebase console: Project settings > General > Your apps > SDK setup
# NEVER hardcode these values here or in source files — keep them in .env.local only
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
